{
  "name": "seatlock-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:reset": "node --env-file-if-exists=.env db/reset.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:seed:demo": "node --env-file-if-exists=.env scripts/seed.js --demo",
    "race-demo": "node --env-file-if-exists=.env scripts/race-demo.js",
    "loadtest": "node --env-file-if-exists=.env scripts/loadtest.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}

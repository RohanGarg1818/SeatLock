# ---- Core -------------------------------------------------------------
# development | production | test. In production, cookies get the Secure flag and weak secrets are rejected.
NODE_ENV=development
# Port the API listens on (Render sets PORT for you).
PORT=4000
# Postgres connection string. With docker-compose.yml: postgres://seatlock:seatlock@localhost:5432/seatlock
# On Neon use the *pooled* connection string (host contains "-pooler") and keep DB_POOL_MAX small.
DATABASE_URL=postgres://seatlock:seatlock@localhost:5432/seatlock
# A separate database used ONLY by `npm test` (tests TRUNCATE tables; the name must contain "test").
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5432/seatlock_test
# Max connections in this process's pg pool. Total across API instances must stay below Postgres's limit.
DB_POOL_MAX=20

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
# Signs login tokens (JWT).
JWT_SECRET=change-me-dev-only-jwt-secret-0000000000
# Signs QR tickets (HMAC-SHA256). Different from JWT_SECRET so a leak of one does not break the other.
TICKET_SECRET=change-me-dev-only-ticket-secret-00000
# Optional: the PREVIOUS ticket secret, accepted for verification only. Set it while rotating TICKET_SECRET
# so tickets already issued keep working; remove it once the event is over.
TICKET_SECRET_PREVIOUS=

# ---- Auth / security ---------------------------------------------------
# Cost factor for bcrypt. 10 is a sensible default; tests use a lower value.
BCRYPT_COST=10
# Number of reverse proxies in front of the API (Render = 1). Needed so rate limiting sees the real client IP.
TRUST_PROXY=0
# Comma-separated website origins allowed to make cookie-authenticated writes (CSRF defence in depth).
# Empty = check disabled. Example: https://seatlock.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Rate limits (fixed window, per minute). Auth limits are per IP; booking limits are per user.
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_BOOKING_PER_MIN=30

# Public URL of the website. Used only for links inside .ics calendar files.
WEB_URL=http://localhost:3000

# ---- Seeding -----------------------------------------------------------
# `npm run db:seed` creates (or promotes) this user as the first platform admin.
ADMIN_EMAIL=admin@seatlock.dev
# Only used if the ADMIN_EMAIL user does not exist yet.
ADMIN_PASSWORD=admin12345

# ---- Background jobs ---------------------------------------------------
# How often the hold-expiry sweeper runs inside the API process.
SWEEP_INTERVAL_SECONDS=30
# How often Redis counters are compared to Postgres and corrected (only when Redis is enabled).
RECONCILE_INTERVAL_SECONDS=60

# ---- Redis (optional) ---------------------------------------------------
# Leave empty to run Postgres-only. On Upstash use the rediss:// URL.
REDIS_URL=redis://localhost:6379
# Set to false to ignore REDIS_URL (handy for A/B load tests).
REDIS_ENABLED=true

# ---- Demo --------------------------------------------------------------
# Enables /demo/* endpoints (naive booking endpoint + race runner). NEVER enable in production.
ENABLE_DEMO=true

# ---- Cloudinary (optional) ---------------------------------------------
# If any is empty, banner uploads are hidden and events use a typographic cover.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Logging -----------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Waitlist -----------------------------------------------------------
# When a seat frees up and someone is waiting, the first person in line gets a hold of this many minutes
# (longer than a normal hold because they may not be looking at the page).
WAITLIST_HOLD_MINUTES=15

# ---- Email (optional, via Resend: https://resend.com) --------------------
# Without both values no email is sent and the site still works (people see their ticket / hold on the website).
RESEND_API_KEY=
# A sender address on a domain you verified in Resend, e.g. "SeatLock <tickets@yourdomain.com>"
MAIL_FROM=

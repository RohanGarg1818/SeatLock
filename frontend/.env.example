# Where the Express API is reachable FROM THE NEXT.JS SERVER (used by rewrites and server components).
# Local: http://localhost:4000   Production: your Render URL, e.g. https://seatlock-api.onrender.com
API_URL=http://localhost:4000

# Public URL of THIS website. Used for absolute Open Graph / Twitter image URLs and share links.
# Local: http://localhost:3000   Production: https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
